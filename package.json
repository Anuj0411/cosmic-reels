  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "render:flight": "remotion render NightFlightReel out/night-flight-reel.mp4",
    "render:meteors": "remotion render MeteorShowerReel out/meteor-shower-reel.mp4",
    "render:supernova": "remotion render SupernovaReel out/supernova-reel.mp4",
    "render:blackhole": "remotion render BlackHoleReel out/black-hole-reel.mp4",
    "render:nebula": "remotion render NebulaFlyReel out/nebula-n49-push.mp4",
    "render:stills": "remotion render NebulaFlyReel out/nebula-n49-push.mp4 && remotion render N49RevealReel out/nebula-n49-reveal.mp4 && remotion render SouthernCrabOrbitReel out/nebula-crab-orbit.mp4 && remotion render StarNurseryRiseReel out/nebula-nursery-rise.mp4 && remotion render Snr0519PunchReel out/nebula-snr0519-punch.mp4 && remotion render Snr1006TrackReel out/nebula-snr1006-track.mp4 && remotion render M82GlideReel out/nebula-m82-glide.mp4",
    "render:sombrero": "remotion render SombreroReel out/sombrero-reel.mp4 --port=3124"
  },
  "allowScripts": {
    "esbuild": false
  }
}
